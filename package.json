{
  "name": "weather-hubcasale-card",
  "version": "0.3.0",
  "description": "Scheda Lovelace per la stazione meteo personale: blocchi con barra temporale, mappa radar, grafici in popup, preferenze salvate dall'integrazione weather_hubcasale.",
  "license": "MIT",
  "author": "Corrado Gamberoni",
  "repository": {"type": "git", "url": "https://github.com/hubcasale/weather-hubcasale-card"},
  "scripts": {
    "build": "esbuild src/weather-hubcasale-card.ts --bundle --format=esm --minify --outfile=custom_components/weather_hubcasale/frontend/weather-hubcasale-card.js",
    "build:dev": "esbuild src/weather-hubcasale-card.ts --bundle --format=iife --outfile=dev/bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=cjs --outdir=.test-build --log-level=warning && node --test .test-build/"
  },
  "devDependencies": {"esbuild": "^0.24.0", "typescript": "^5.6.0"},
  "dependencies": {"lit": "^3.2.0"}
}
